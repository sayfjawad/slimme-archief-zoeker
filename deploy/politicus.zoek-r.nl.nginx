# Edge VPS (vmi2702091) vhost for the combined politici app.
# Proxies https://politicus.zoek-r.nl -> c4130 :8905 over Tailscale, with
# streaming-friendly settings for the /media endpoint.
#
# Install:
#   sudo cp deploy/politicus.zoek-r.nl.nginx /etc/nginx/sites-available/politicus.zoek-r.nl
#   sudo ln -s ../sites-available/politicus.zoek-r.nl /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d politicus.zoek-r.nl        # adds the 443 server + redirect
server {
    server_name politicus.zoek-r.nl;

    location / {
        proxy_pass http://100.64.0.13:8905;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # media streaming (mp4/opus): no buffering, long timeouts, range replies
        proxy_buffering off;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }

    listen 80;
    listen [::]:80;
}
